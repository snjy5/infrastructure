# ansible/roles/nginx/templates/reverse-proxy.conf.j2
# Managed by Ansible - Do not edit manually

server {
    listen 443 ssl http2;
    server_name www.{{ main_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ san_domains[0] }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ san_domains[0] }}/privkey.pem;
    ssl_protocols {{ nginx_ssl_protocols }};
    ssl_ciphers {{ nginx_ssl_ciphers }};

    return 301 https://{{ main_domain }}$request_uri;
}

{% for app in services %}
server {
    listen 80;
    server_name {{ app.hostnames | join(' ') }};

    location /.well-known/acme-challenge/ {
        root {{ webroot_path }};
    }

    location / {
        return 301 https://{{ app.hostnames[0] }}$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name {{ app.hostnames | join(' ') }};

    ssl_certificate     /etc/letsencrypt/live/{{ san_domains[0] }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ san_domains[0] }}/privkey.pem;
    ssl_protocols {{ nginx_ssl_protocols }};
    ssl_ciphers {{ nginx_ssl_ciphers }};

    location / {
        proxy_pass http://127.0.0.1:{{ app.port }};

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_hide_header Cache-Control;
        proxy_hide_header Pragma;
        proxy_hide_header Expires;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }
}

{% endfor %}
