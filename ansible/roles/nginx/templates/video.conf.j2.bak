user nobody;
worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include mime.types;
    default_type application/octet-stream;

    # Performance & Socket Optimization
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 15;

    # Request Buffer Limits
    client_body_buffer_size 128k;
    client_header_buffer_size 1k;
    client_max_body_size 8m;
    large_client_header_buffers 4 8k;

    # Asynchronous I/O & Large File Handling
    directio 4m;
    directio_alignment 512;
    aio threads;

    # File Descriptor Cache
    open_file_cache max=10000 inactive=60s;
    open_file_cache_valid 30s;
    open_file_cache_min_uses 2;
    open_file_cache_errors off;

    server {
        listen 8080;
        server_name localhost;

        root /var/www/html;
        index index.html index.htm;

        # Streaming Rate Limiting (initial burst + steady bitrate)
        limit_rate_after 5m;
        limit_rate 1m;

        location / {
            try_files $uri $uri/ =404;
        }

        # Media Handling & Byte-Range Optimization
        location ~* \.(mp4|m4v|mkv|webm|ts|m3u8)$ {
            mp4;
            mp4_buffer_size 1m;
            mp4_max_buffer_size 5m;

            # Enable byte-range support for video seeking
            add_header Accept-Ranges bytes;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }

        error_page 500 502 503 504 /50x.html;
        location = /50x.html {
            root /var/www/html;
        }
    }
}
