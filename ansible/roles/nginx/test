#!/usr/bin/python3
import argparse
import os

parser = argparse.ArgumentParser(description="Nginx Mode Wrapper")
parser.add_argument("-m", choices=["file", "video"], required=True, help="Operating mode")
parser.add_argument("-d", default="nginx", help="Directory containing config files (defaults to ./nginx)")

args = parser.parse_args()

config_dir = os.path.abspath(args.d)
config_file = os.path.join(config_dir, f"nginx-{args.m}.conf")

if not os.path.isfile(config_file):
    print(f"Error: Config file not found at '{config_file}'")
    exit(1)

print(f"Starting Nginx with mode '{args.m}' using config '{config_file}'...")

os.execvp("nginx", ["nginx", "-g", "daemon off;", "-c", config_file])

